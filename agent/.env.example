# Copy to .env on each VM and fill in. Never commit .env.

# ---------------------------------------------------------------- general
HOST_NAME=vm1
TZ=Asia/Tehran
# "backup" on vm1/vm2 (starts backup-runner). Leave EMPTY on vm3.
COMPOSE_PROFILES=backup
TEXTFILE_HOST_DIR=/var/lib/node-exporter/textfile

# ---------------------------------------------------------------- exporters
NODE_EXPORTER_LISTEN=0.0.0.0:9100
# Set to this VM's private IP so cAdvisor is not exposed publicly.
CADVISOR_BIND=0.0.0.0
CADVISOR_PORT=9338
# Containers that must page when down/unhealthy (comma separated, container names).
CRITICAL_CONTAINERS=postgres,mongo

# ---------------------------------------------------------------- restic
# User/password = the htpasswd entry created on vm3 with scripts/add-restic-user.sh.
# Use hex passwords (openssl rand -hex 24) so they need no URL-encoding.
RESTIC_REPOSITORY=rest:http://vm1:CHANGE_ME@77.42.20.237:8000/vm1/
# Repository encryption key. Keep a copy OFF these VMs (password manager)!
RESTIC_PASSWORD=CHANGE_ME
# RESTIC_CACERT=/etc/backup/rest-server.crt   # when rest-server runs with TLS

# ---------------------------------------------------------------- postgres
# Space separated postgres container names on this VM. Empty = skip job.
PG_CONTAINERS=
# Databases to dump. Empty = every non-template database.
PG_DATABASES=
# Dump user. Empty = container's $POSTGRES_USER, else "postgres".
PG_USER=

# ---------------------------------------------------------------- mongodb
# Space separated mongo container names. Empty = skip job.
MONGO_CONTAINERS=
# Credentials for mongodump. Empty = the container's MONGO_INITDB_ROOT_USERNAME/PASSWORD
# (only correct if the password was not changed after the database was created).
# Best: a dedicated user with the "backup" role (see docs/setup-vm3.md, step 13).
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_DB=admin
# true only if mongo runs as a replica set (needed for --oplog).
MONGO_OPLOG=false
MONGO_DUMP_EXTRA_ARGS=

# ---------------------------------------------------------------- minio
# MinIO S3 endpoint. Empty = skip job. host.docker.internal = this VM.
MINIO_URL=
# Read access to all buckets is enough (the root user works too).
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Space separated buckets. Empty = all buckets.
MINIO_BUCKETS=
# Local copy of the buckets that restic snapshots (needs disk ≈ size of the buckets).
MINIO_STAGING_HOST_DIR=/var/lib/backup-staging/minio

# ---------------------------------------------------------------- files / configs
# Compose files, configs, certificates ... (mounted read-only)
FILES_SOURCE_HOST_DIR=/opt
