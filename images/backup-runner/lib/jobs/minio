#!/usr/bin/env bash
# MinIO backup: sync every bucket into a local staging directory with rclone
# (S3 API, incremental: only changed objects are downloaded), then snapshot
# the staging directory with restic. Only the latest version of each object
# is backed up. Users and bucket policies are not part of the S3 API data and
# must be kept separately (see README).
#
# env: MINIO_URL MINIO_ACCESS_KEY MINIO_SECRET_KEY (required), MINIO_BUCKETS
set -Eeuo pipefail
source /usr/local/lib/backup/common.sh

if [[ ${1:-} == --enabled ]]; then [[ -n ${MINIO_URL:-} ]]; exit; fi
require_env MINIO_ACCESS_KEY MINIO_SECRET_KEY

# rclone remote "minio:" configured entirely from the environment.
export RCLONE_CONFIG=/tmp/rclone.conf
export RCLONE_CONFIG_MINIO_TYPE=s3
export RCLONE_CONFIG_MINIO_PROVIDER=Minio
export RCLONE_CONFIG_MINIO_ENDPOINT=$MINIO_URL
export RCLONE_CONFIG_MINIO_ACCESS_KEY_ID=$MINIO_ACCESS_KEY
export RCLONE_CONFIG_MINIO_SECRET_ACCESS_KEY=$MINIO_SECRET_KEY
touch "$RCLONE_CONFIG"

stage=/staging/minio

if [[ -n ${MINIO_BUCKETS:-} ]]; then
  buckets=$(words "$MINIO_BUCKETS")
else
  buckets=$(rclone lsf --dirs-only minio: | sed 's#/$##')
fi
[[ -n $buckets ]] || die "no buckets found on $MINIO_URL"

for b in $buckets; do
  log "sync bucket $b"
  rclone sync "minio:$b" "$stage/$b" --transfers 8 --stats 0
done

restic_paths minio "$stage"
