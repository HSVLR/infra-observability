#!/usr/bin/env bash
# MinIO backup: mirror buckets into a local staging directory (incremental),
# export bucket metadata + IAM, then snapshot the staging directory with restic.
# Only the latest version of each object is backed up.
#
# env: MINIO_URL MINIO_ACCESS_KEY MINIO_SECRET_KEY (required), MINIO_BUCKETS
set -Eeuo pipefail
source /usr/local/lib/backup/common.sh

if [[ ${1:-} == --enabled ]]; then [[ -n ${MINIO_URL:-} ]]; exit; fi
require_env MINIO_ACCESS_KEY MINIO_SECRET_KEY

stage=/staging/minio
export MC_CONFIG_DIR=/tmp/mc
mc alias set src "$MINIO_URL" "$MINIO_ACCESS_KEY" "$MINIO_SECRET_KEY" >/dev/null

if [[ -n ${MINIO_BUCKETS:-} ]]; then
  buckets=$(words "$MINIO_BUCKETS")
else
  buckets=$(mc ls --json src | jq -r '.key | rtrimstr("/")')
fi

mkdir -p "$stage/data" "$stage/meta"
for b in $buckets; do
  log "mirror bucket $b"
  mc mirror --quiet --overwrite --remove "src/$b" "$stage/data/$b"
  mc anonymous get-json "src/$b" > "$stage/meta/$b.anonymous-policy.json" 2>/dev/null || true
  mc version info --json "src/$b" > "$stage/meta/$b.versioning.json" 2>/dev/null || true
done

# Bucket metadata (policies, lifecycle, versioning...) and IAM (users, groups,
# policies). Needs admin credentials; a warning only, data is what matters most.
(cd "$stage/meta" && mc admin cluster bucket export src >/dev/null) \
  || log "WARN: could not export bucket metadata (admin credentials needed)"
(cd "$stage/meta" && mc admin cluster iam export src >/dev/null) \
  || log "WARN: could not export IAM (admin credentials needed)"

restic_paths minio "$stage"
