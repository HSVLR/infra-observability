# Copy to .env on vm3 and fill in. Never commit .env.

TZ=Asia/Tehran
TEXTFILE_HOST_DIR=/var/lib/node-exporter/textfile

# ---------------------------------------------------------------- prometheus
PROMETHEUS_RETENTION=30d

# ---------------------------------------------------------------- grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_ROOT_URL=http://10.0.0.13:3000
GRAFANA_BIND=0.0.0.0

# Alert notifications (Telegram bot). See docs/alerting.md for other channels.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------- restic / rest-server
# Where the repositories live on vm3's disk (one sub-directory per VM).
RESTIC_DATA_HOST_DIR=/srv/restic
# Private IP of vm3 (docker-published ports bypass ufw).
REST_SERVER_BIND=0.0.0.0
# e.g. "--tls --tls-cert /etc/rest-server/tls.crt --tls-key /etc/rest-server/tls.key"
REST_SERVER_EXTRA_OPTIONS=

# Retention, applied by backup-maintenance (clients are append-only).
KEEP_DAILY=30
KEEP_WEEKLY=8
KEEP_MONTHLY=6
# Share of pack data read back by the weekly "restic check".
CHECK_READ_SUBSET=5%

# Monthly restore test. Entries: <repo>/postgres/<container>/<db>  or  <repo>/mongodb/<container>
RESTORE_TESTS=vm1/postgres/postgres/app vm2/mongodb/mongo
# Use the same major versions as production.
RESTORE_PG_IMAGE=postgres:16
RESTORE_MONGO_IMAGE=mongo:7
