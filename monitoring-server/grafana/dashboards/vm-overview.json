    {
      "type": "timeseries",
      "title": "Disk I/O time (busy %)",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * rate(node_disk_io_time_seconds_total{device!~\"loop.*|sr.*\",host=~\"$host\"}[5m])",
          "legendFormat": "{{host}} {{device}}"
