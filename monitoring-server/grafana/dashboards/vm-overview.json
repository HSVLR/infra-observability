    {
      "type": "timeseries",
      "title": "Network errors",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (host) (rate(node_network_receive_errs_total{host=~\"$host\"}[5m]) + rate(node_network_transmit_errs_total{host=~\"$host\"}[5m]))",
